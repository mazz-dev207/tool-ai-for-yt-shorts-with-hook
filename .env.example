# Gemini highlight judge
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ENABLED=true
HIGHLIGHT_MODE=legacy
CONTENT_PROFILE=auto

# Cost / quality controls
GEMINI_CONTEXT_BEFORE=8
GEMINI_CONTEXT_AFTER=8
GEMINI_MAX_CANDIDATES=60
GEMINI_TOP_HIGHLIGHTS=10
GEMINI_MIN_SCORE=55
GEMINI_OVERLAP_THRESHOLD=0.60
GEMINI_MAX_RETRIES=2
